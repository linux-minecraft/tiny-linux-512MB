#!/bin/sh
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev 2>/dev/null
# devtmpfs 失败或节点缺失时手工补 (getty 依赖)
[ -e /dev/null ]    || mknod /dev/null    c 1 3
[ -e /dev/console ] || mknod /dev/console c 5 1
[ -e /dev/ttyS0 ]   || mknod /dev/ttyS0   c 4 64
[ -e /dev/tty1 ]    || mknod /dev/tty1    c 4 1
[ -e /dev/tty2 ]    || mknod /dev/tty2    c 4 2
[ -e /dev/tty ]     || mknod /dev/tty     c 5 0
mkdir -p /dev/pts 2>/dev/null
mount -t devpts devpts /dev/pts 2>/dev/null
echo "rootfs mounted, starting shell..."
hostname mylinux
mkdir -p /root /home

# === Persistence support ===
sleep 1
PERSIST_DEV=""
for dev in /dev/sd[a-z][0-9]* /dev/mmcblk[0-9]*p[0-9]* /dev/nvme[0-9]*n[0-9]*p[0-9]* /dev/vd[a-z][0-9]*; do
    [ -b "$dev" ] || continue
    lbl=$(blkid -s LABEL -o value "$dev" 2>/dev/null)
    if [ "$lbl" = "persistence" ]; then
        PERSIST_DEV="$dev"
        break
    fi
done
if [ -n "$PERSIST_DEV" ]; then
    echo "[persistence] found $PERSIST_DEV"
    mkdir -p /mnt/persistence
    if mount -t ext4 "$PERSIST_DEV" /mnt/persistence 2>/dev/null || \
       mount -t ext3 "$PERSIST_DEV" /mnt/persistence 2>/dev/null || \
       mount -t ext2 "$PERSIST_DEV" /mnt/persistence 2>/dev/null; then
        [ -d /mnt/persistence/root ] && mount -o bind /mnt/persistence/root /root
        [ -d /mnt/persistence/home ] && mount -o bind /mnt/persistence/home /home
        echo "[persistence] /root /home bound"
    else
        echo "[persistence] mount failed"
    fi
else
    echo "[persistence] no labeled partition, running in RAM mode"
fi
