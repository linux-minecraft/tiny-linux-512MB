if serial --unit=0 --speed=115200; then
  terminal_input serial console
  terminal_output serial console
fi
set default=0
set timeout=3
set fallback=2

menuentry "MyLinux 6.12.43 (serial console)" {
  linux /boot/vmlinuz console=ttyS0,115200 rdinit=/sbin/init
  initrd /boot/initramfs.xz
}

menuentry "MyLinux 6.12.43 (VGA console)" {
  linux /boot/vmlinuz console=tty1 rdinit=/sbin/init
  initrd /boot/initramfs.xz
}

menuentry "MyLinux 6.12.43 rescue (init=/bin/sh)" {
  linux /boot/vmlinuz console=ttyS0,115200 console=tty1 rdinit=/bin/sh
  initrd /boot/initramfs.xz
}
